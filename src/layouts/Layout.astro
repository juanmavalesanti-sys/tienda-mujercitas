---
// src/layouts/Layout.astro
import '../styles/global.css';

interface Props {
	title: string;
}

const { title } = Astro.props;
const user = Astro.locals.user;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title} | Mujercitas</title>
		<link rel="preconnect" href="https://googleapis.com">
		<link rel="preconnect" href="https://gstatic.com" crossorigin>
		<link href="https://googleapis.com/css2?family=Montserrat:wght@300;400;600&family=Playfair+Display:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet">
	</head>
	<body class="bg-white text-neutral-800 font-['Montserrat'] min-h-screen flex flex-col">
		
		<header class="border-b border-neutral-100 sticky top-0 bg-white/90 backdrop-blur-md z-50">
			<div class="max-w-7xl mx-auto px-4 h-20 flex justify-between items-center">
				<a href="/" class="font-['Playfair_Display'] text-2xl font-bold tracking-wide text-neutral-800">
					Mujercitas<span class="text-[#FFD1DC]">.</span>
				</a>
				<!-- Busca esta sección en tu src/layouts/Layout.astro y cámbiala por esto: -->
<nav class="hidden md:flex space-x-8 text-sm tracking-widest uppercase items-center">
	<a href="/" class="hover:text-[#FFD1DC] transition-colors">Inicio</a>
	<a href="/catalogo" class="hover:text-[#FFD1DC] transition-colors">Catálogo</a>
	{user ? (
		<>
			{user.rol === 'admin' && (
				<a href="/admin" class="text-xs border border-neutral-200 px-4 py-1.5 rounded-sm hover:bg-neutral-50 transition-all font-semibold text-neutral-500">Panel admin</a>
			)}
			<button id="nav-logout-btn" class="text-xs border border-neutral-200 px-4 py-1.5 rounded-sm hover:bg-neutral-50 transition-all font-semibold text-neutral-500">Cerrar sesión</button>
		</>
	) : (
		<a href="/login" class="text-xs border border-neutral-200 px-4 py-1.5 rounded-sm hover:bg-neutral-50 transition-all font-semibold text-neutral-500">Ingresar</a>
	)}
</nav>

					<div class="flex items-center space-x-4">
						<a href="/carrito" class="relative cursor-pointer py-2 block select-none hover:opacity-80 transition-opacity">
						<span class="text-xl">🛍️</span>
						<span id="cart-count" class="absolute -top-1 -right-2 bg-[#FFD1DC] text-xs font-bold w-5 h-5 rounded-full flex items-center justify-center text-neutral-800">0</span>
						</a>
					</div>

			</div>
		</header>

		<main class="flex-grow">
			<slot />
		</main>

		<footer class="bg-neutral-50 border-t border-neutral-100 py-12 text-center text-xs tracking-wider text-neutral-400">
			<p class="font-['Playfair_Display'] text-base italic text-neutral-800 mb-2">Mujercitas Tienda Online</p>
			<p>&copy; 2026 Todos los derechos reservados.</p>
		</footer>

	</body>
</html>

<script is:inline>
	const navLogoutBtn = document.getElementById('nav-logout-btn');
	if (navLogoutBtn) {
		navLogoutBtn.addEventListener('click', async () => {
			await fetch('/api/logout', { method: 'POST' });
			window.location.href = '/login';
		});
	}
</script>

<style is:global>
	h1, h2, h3 {
		font-family: 'Playfair Display', serif;
	}
</style>
