---
// src/pages/login.astro
import Layout from '../layouts/Layout.astro';
---

<Layout title="Iniciar Sesión">
	<section class="max-w-md mx-auto px-4 py-20 flex-grow flex flex-col justify-center animate-fade-in">

		<!-- Contenedor del Formulario Minimalista -->
		<div class="bg-white border border-neutral-100 p-8 rounded-sm shadow-xs">
			<div class="text-center mb-8">
				<h1 class="text-2xl font-bold text-neutral-800 tracking-wide font-['Playfair_Display']">Bienvenida a Mujercitas</h1>
				<p class="text-xs text-neutral-400 font-light mt-1 uppercase tracking-widest">Ingresa tus datos para continuar</p>
				<div class="w-8 h-[1px] bg-[#FFD1DC] mx-auto mt-4"></div>
			</div>

			<form id="login-form" class="space-y-5">
				<div>
					<label class="block text-[10px] uppercase tracking-widest text-neutral-400 font-bold mb-1">Correo Electrónico</label>
					<input type="email" id="login-email" required placeholder="tuemail@ejemplo.com" class="w-full text-xs p-3 border border-neutral-200 rounded-sm bg-neutral-50/50 focus:outline-none focus:border-[#FFD1DC] transition-colors" />
				</div>

				<div>
					<label class="block text-[10px] uppercase tracking-widest text-neutral-400 font-bold mb-1">Contraseña</label>
					<input type="password" id="login-password" required placeholder="••••••••" class="w-full text-xs p-3 border border-neutral-200 rounded-sm bg-neutral-50/50 focus:outline-none focus:border-[#FFD1DC] transition-colors" />
				</div>

				<p id="login-error" class="text-xs text-red-500 font-medium hidden"></p>

				<button type="submit" id="login-submit-btn" class="w-full bg-neutral-800 text-white py-4 text-xs tracking-widest uppercase font-bold hover:bg-[#FFD1DC] hover:text-neutral-800 transition-all duration-300 rounded-sm shadow-md mt-2">
					Iniciar Sesión
				</button>
			</form>
		</div>

	</section>
</Layout>

<script is:inline>
	// Sincroniza la burbuja del Navbar
	let carrito = JSON.parse(localStorage.getItem('carrito') || '[]');
	const countEl = document.getElementById('cart-count');
	if(countEl) {
		countEl.innerText = carrito.reduce((sum, item) => sum + item.cantidad, 0).toString();
	}

	// Procesar el evento del Login contra el backend real
	const form = document.getElementById('login-form');
	const errorEl = document.getElementById('login-error');
	const submitBtn = document.getElementById('login-submit-btn');

	form.addEventListener('submit', async (e) => {
		e.preventDefault();

		const email = document.getElementById('login-email').value.trim();
		const password = document.getElementById('login-password').value;

		errorEl.classList.add('hidden');
		submitBtn.disabled = true;

		try {
			const respuesta = await fetch('/api/login', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ email, password })
			});
			const resultado = await respuesta.json();

			if (respuesta.ok && resultado.success) {
				window.location.href = resultado.rol === 'admin' ? '/admin' : '/catalogo';
			} else {
				errorEl.innerText = resultado.error || 'No se pudo iniciar sesión.';
				errorEl.classList.remove('hidden');
				submitBtn.disabled = false;
			}
		} catch (error) {
			errorEl.innerText = 'Error de conexión. Inténtalo de nuevo.';
			errorEl.classList.remove('hidden');
			submitBtn.disabled = false;
		}
	});
</script>

<style>
	@keyframes fadeIn {
		from { opacity: 0; transform: translateY(10px); }
		to { opacity: 1; transform: translateY(0); }
	}
	.animate-fade-in {
		animation: fadeIn 0.4s ease-out forwards;
	}
</style>
