---
// src/pages/admin.astro
import Layout from '../layouts/Layout.astro';
import pool from '../lib/db.js';

// 1. Cargamos la lista REAL y completa de ítems directo de tu base de datos MySQL
let listaProductos = [];
let totalProductosDB = 0;

try {
  const [rows] = await pool.query('SELECT * FROM productos ORDER BY id DESC') as any;
  listaProductos = rows;
  totalProductosDB = listaProductos.length;
} catch (error) {
  console.log("Database connection active, waiting for tables.");
}

// 2. Si MySQL está vacío por contingencia, mostramos datos base para que no se vea roto
if (listaProductos.length === 0) {
  listaProductos = [
    { id: 1, nombre: 'Vestido Primavera Rosa', descripcion: 'Vestido largo sutil.', precio: 45.99, imagen_url: '/imagenes/vestido-rosa.png' },
    { id: 2, nombre: 'Blusa Minimalista Blanca', descripcion: 'Blusa clásica de lino.', precio: 29.99, imagen_url: '/imagenes/blusa-blanca.png' },
    { id: 3, nombre: 'Chaqueta Pastel Denim', descripcion: 'Casaca ligera de mezclilla.', precio: 59.99, imagen_url: '/imagenes/chaqueta-denim.png' }
  ];
  totalProductosDB = 3;
}

// La protección real de esta ruta ocurre en src/middleware.ts (server-side).
// Si llegamos hasta acá, Astro.locals.user ya es un admin autenticado.
const adminEmail = Astro.locals.user?.email ?? '';

// 3. Cargamos los pedidos reales y sus items para el panel de gestión
let pedidos: any[] = [];
let itemsPorPedido: Record<number, any[]> = {};
try {
  const [pedidosRows] = (await pool.query(
    `SELECT id, token, cliente_nombre, cliente_telefono, direccion_envio,
            metodo_pago, estado, total, fecha
     FROM pedidos ORDER BY fecha DESC`
  )) as any;
  pedidos = pedidosRows;

  if (pedidos.length > 0) {
    const ids = pedidos.map((p) => p.id);
    const [itemRows] = (await pool.query(
      `SELECT pedido_id, nombre_producto, precio_unitario, cantidad, subtotal
       FROM pedido_items WHERE pedido_id IN (?)`,
      [ids]
    )) as any;
    for (const item of itemRows) {
      if (!itemsPorPedido[item.pedido_id]) itemsPorPedido[item.pedido_id] = [];
      itemsPorPedido[item.pedido_id].push(item);
    }
  }
} catch (error) {
  console.log('Database connection active, waiting for tables.');
}

const ESTADO_LABELS: Record<string, string> = {
  pendiente_pago: 'Pendiente de pago',
  pagado: 'Pagado',
  enviado: 'Enviado',
  cancelado: 'Cancelado',
};

const ESTADO_BADGE_CLASSES: Record<string, string> = {
  pendiente_pago: 'bg-amber-100 text-amber-700',
  pagado: 'bg-blue-100 text-blue-700',
  enviado: 'bg-emerald-100 text-emerald-700',
  cancelado: 'bg-red-100 text-red-700',
};
---

<Layout title="Panel de Administración Completo">
	<section class="max-w-6xl mx-auto px-4 py-12 flex-grow">
		
		<!-- Encabezado del Panel -->
		<div class="flex flex-col md:flex-row justify-between items-start md:items-center border-b border-neutral-100 pb-6 mb-10 gap-4">
			<div>
				<h1 class="text-3xl font-bold text-neutral-800 tracking-wide font-['Playfair_Display']">Panel de Control</h1>
				<p class="text-xs text-neutral-400 font-light mt-1 tracking-wider uppercase">Gestión de inventario, edición y pedidos reales en MySQL</p>
			</div>
			<div class="flex items-center gap-3">
				<span class="text-[10px] uppercase tracking-widest bg-neutral-900 text-white px-3 py-1.5 font-bold rounded-xs shadow-xs">Sesión: {adminEmail}</span>
				<button id="btn-logout" class="text-[10px] uppercase tracking-widest border border-neutral-200 px-3 py-1.5 font-bold rounded-xs text-neutral-500 hover:bg-neutral-50 transition-colors">Cerrar sesión</button>
			</div>
		</div>

		<!-- Tarjetas de Métricas -->
		<div class="grid grid-cols-1 sm:grid-cols-3 gap-6 mb-12">
			<div class="bg-neutral-50 border border-neutral-100 p-5 rounded-sm">
				<span class="text-2xl block mb-1">👗</span>
				<h4 class="text-[10px] uppercase tracking-widest text-neutral-400 font-bold">Prendas en Base de Datos</h4>
				<p class="text-2xl font-bold text-neutral-800 mt-1">{totalProductosDB}</p>
			</div>
			<div class="bg-neutral-50 border border-neutral-100 p-5 rounded-sm">
				<span class="text-2xl block mb-1">📦</span>
				<h4 class="text-[10px] uppercase tracking-widest text-neutral-400 font-bold">Pedidos Recibidos</h4>
				<p class="text-2xl font-bold text-neutral-800 mt-1">{pedidos.length}</p>
			</div>
			<div class="bg-neutral-50 border border-neutral-100 p-5 rounded-sm">
				<span class="text-2xl block mb-1">●</span>
				<h4 class="text-[10px] uppercase tracking-widest text-neutral-400 font-bold">Estado de Conexión</h4>
				<p class="text-xs font-semibold mt-2 text-emerald-600 flex items-center gap-1">Servidor Local Activo</p>
			</div>
		</div>

		<div class="grid grid-cols-1 lg:grid-cols-3 gap-10">
			
			<!-- Formulario para Agregar Prenda -->
			<div class="bg-white border border-neutral-100 p-6 rounded-sm shadow-xs h-fit">
				<h3 class="text-sm uppercase tracking-widest text-neutral-800 font-bold mb-6 flex items-center gap-2">✨ Agregar Nueva Prenda</h3>
				<form id="add-product-form" class="space-y-4">
					<div>
						<label class="block text-[10px] uppercase tracking-widest text-neutral-400 font-bold mb-1">Nombre del artículo</label>
						<input type="text" id="prod-nombre" required placeholder="Ej. Falda Plisada Pastel" class="w-full text-xs p-3 border border-neutral-200 rounded-sm bg-neutral-50/50 focus:outline-none focus:border-[#FFD1DC] transition-colors" />
					</div>
					<div>
						<label class="block text-[10px] uppercase tracking-widest text-neutral-400 font-bold mb-1">Precio de venta ($)</label>
						<input type="number" id="prod-precio" step="0.01" required placeholder="Ej. 39.99" class="w-full text-xs p-3 border border-neutral-200 rounded-sm bg-neutral-50/50 focus:outline-none focus:border-[#FFD1DC] transition-colors" />
					</div>
					<div>
						<label class="block text-[10px] uppercase tracking-widest text-neutral-400 font-bold mb-1">Descripción de la prenda</label>
						<textarea id="prod-descripcion" rows="3" required placeholder="Detalles de costura, tallas o material..." class="w-full text-xs p-3 border border-neutral-200 rounded-sm bg-neutral-50/50 focus:outline-none focus:border-[#FFD1DC] transition-colors resize-none"></textarea>
					</div>
					<div>
						<label class="block text-[10px] uppercase tracking-widest text-neutral-400 font-bold mb-1">Foto del producto</label>
						<input type="file" id="prod-imagen-file" accept="image/png,image/jpeg,image/webp" required class="w-full text-xs p-2.5 border border-neutral-200 rounded-sm bg-neutral-50/50 focus:outline-none focus:border-[#FFD1DC] transition-colors cursor-pointer" />
						<p class="text-[10px] text-neutral-400 font-light mt-1">PNG, JPG o WEBP. Máximo 5MB.</p>
					</div>
					<button type="submit" class="w-full bg-neutral-800 text-white py-4 text-xs tracking-widest uppercase font-bold hover:bg-[#FFD1DC] hover:text-neutral-800 transition-all duration-300 rounded-sm shadow-md">Subir a Catálogo Real</button>
				</form>
			</div>

			<!-- LADO DERECHO: LISTA COMPLETA REAL DE ÍTEMS CON ACCIONES -->
			<div class="lg:col-span-2 space-y-8">
				<div class="bg-white border border-neutral-100 p-6 rounded-sm shadow-xs">
					<h3 class="text-sm uppercase tracking-widest text-neutral-800 font-bold mb-6">Lista Completa de Artículos (Inventario MySQL)</h3>
					<div class="overflow-x-auto">
						<table class="w-full text-left border-collapse text-xs">
							<thead>
								<tr class="border-b border-neutral-100 text-neutral-400 uppercase tracking-wider font-bold">
									<th class="py-3 font-semibold">ID</th>
									<th class="py-3 font-semibold">Prenda</th>
									<th class="py-3 font-semibold">Precio</th>
									<th class="py-3 text-right font-semibold">Acciones</th>
								</tr>
							</thead>
							<tbody class="divide-y divide-neutral-50 text-neutral-600 font-light">
								{listaProductos.map((item:any) => (
									<tr>
										<td class="py-4 font-normal">#{item.id}</td>
										<td class="py-4 font-medium text-neutral-800">{item.nombre}</td>
										<td class="py-4">${item.precio}</td>
										<td class="py-4 text-right space-x-3">
											<!-- Botón Editar que empaqueta los datos de la fila para el Modal -->
											<button class="btn-open-edit text-neutral-500 hover:text-neutral-800 font-medium transition-colors" data-product={JSON.stringify({id: item.id, nombre: item.nombre, precio: item.precio, descripcion: item.descripcion, imagen_url: item.imagen_url})}>Editar</button>
											<button class="btn-delete-item text-neutral-400 hover:text-red-400 font-medium transition-colors" data-id={item.id}>Retirar</button>
										</td>
									</tr>
								))}
							</tbody>
						</table>
					</div>
				</div>

				<!-- Registro de Órdenes -->
				<div class="bg-white border border-neutral-100 p-6 rounded-sm shadow-xs">
					<h3 class="text-sm uppercase tracking-widest text-neutral-800 font-bold mb-4">Pedidos Recibidos</h3>
					<p class="text-xs text-neutral-400 font-light mb-4">Gestiona los pedidos enviados desde el checkout.</p>
					<div id="admin-orders-list" class="space-y-3">
						{pedidos.length === 0 ? (
							<div class="text-center py-6 text-neutral-400 italic text-xs border border-dashed border-neutral-200 rounded-sm">No se han recibido pedidos todavía.</div>
						) : (
							pedidos.map((p: any) => (
								<div class="border border-neutral-100 rounded-sm p-4">
									<div class="flex flex-wrap justify-between items-start gap-3">
										<div>
											<p class="font-medium text-neutral-800 text-sm">{p.cliente_nombre}</p>
											<p class="text-xs text-neutral-400">{p.cliente_telefono} · {p.direccion_envio}</p>
											<p class="text-xs text-neutral-400 mt-1">Método: {p.metodo_pago} · {new Date(p.fecha).toLocaleString()}</p>
										</div>
										<div class="text-right shrink-0">
											<p class="font-bold text-neutral-800">${Number(p.total).toFixed(2)}</p>
											<span class={`inline-block mt-1 text-[10px] uppercase tracking-widest font-bold px-2 py-1 rounded-xs ${ESTADO_BADGE_CLASSES[p.estado] || 'bg-neutral-100 text-neutral-600'}`}>{ESTADO_LABELS[p.estado] || p.estado}</span>
										</div>
									</div>

									<div class="flex flex-wrap items-center gap-3 mt-3">
										<select class="pedido-estado-select text-xs p-2 border border-neutral-200 rounded-sm bg-neutral-50/50" data-id={p.id.toString()}>
											<option value="pendiente_pago" selected={p.estado === 'pendiente_pago'}>Pendiente de pago</option>
											<option value="pagado" selected={p.estado === 'pagado'}>Pagado</option>
											<option value="enviado" selected={p.estado === 'enviado'}>Enviado</option>
											<option value="cancelado" selected={p.estado === 'cancelado'}>Cancelado</option>
										</select>
										<button class="btn-toggle-items text-[10px] uppercase tracking-widest text-neutral-500 hover:text-neutral-800 font-semibold" data-target={`items-${p.id}`}>Ver items ▾</button>
										<a href={`/pedido/${p.token}`} target="_blank" class="text-[10px] uppercase tracking-widest text-neutral-500 hover:text-neutral-800 font-semibold">Ver confirmación ↗</a>
									</div>

									<div id={`items-${p.id}`} class="hidden mt-3 pt-3 border-t border-neutral-100 space-y-1">
										{(itemsPorPedido[p.id] || []).map((item: any) => (
											<div class="flex justify-between text-xs text-neutral-500">
												<span>{item.nombre_producto} x{item.cantidad}</span>
												<span>${Number(item.subtotal).toFixed(2)}</span>
											</div>
										))}
									</div>
								</div>
							))
						)}
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- TARJETA MODAL INTERACTIVA PARA EDITAR TEXTOS (Oculta por defecto con 'hidden') -->
	<div id="edit-modal" class="fixed inset-0 bg-black/50 backdrop-blur-xs z-50 flex items-center justify-center p-4 hidden">
		<div class="bg-white w-full max-w-md rounded-sm shadow-2xl p-6 relative animate-fade-in max-h-[90vh] overflow-y-auto">
			<button id="close-edit-modal" class="absolute top-4 right-4 text-neutral-400 hover:text-neutral-800 font-bold">✕</button>

			<h3 class="text-base font-bold text-neutral-800 tracking-wide font-['Playfair_Display'] mb-4">Editar Detalles de la Prenda</h3>
			<div class="w-full h-[1px] bg-neutral-100 mb-6"></div>

			<form id="edit-product-form" class="space-y-4">
				<input type="hidden" id="edit-prod-id" />
				<input type="hidden" id="edit-prod-imagen-actual" />
				<div>
					<label class="block text-[10px] uppercase tracking-widest text-neutral-400 font-bold mb-1">Nombre de la Prenda</label>
					<input type="text" id="edit-prod-nombre" required class="w-full text-xs p-3 border border-neutral-200 rounded-sm bg-neutral-50/50 focus:outline-none focus:border-[#FFD1DC] transition-colors" />
				</div>
				<div>
					<label class="block text-[10px] uppercase tracking-widest text-neutral-400 font-bold mb-1">Precio del Artículo ($)</label>
					<input type="number" id="edit-prod-precio" step="0.01" required class="w-full text-xs p-3 border border-neutral-200 rounded-sm bg-neutral-50/50 focus:outline-none focus:border-[#FFD1DC] transition-colors" />
				</div>
				<div>
					<label class="block text-[10px] uppercase tracking-widest text-neutral-400 font-bold mb-1">Descripción / Materiales</label>
					<textarea id="edit-prod-descripcion" rows="3" required class="w-full text-xs p-3 border border-neutral-200 rounded-sm bg-neutral-50/50 focus:outline-none focus:border-[#FFD1DC] transition-colors resize-none"></textarea>
				</div>
				<div>
					<label class="block text-[10px] uppercase tracking-widest text-neutral-400 font-bold mb-1">Foto de la prenda</label>
					<img id="edit-prod-imagen-preview" src="" alt="Foto actual" class="w-full aspect-[3/4] object-cover rounded-sm border border-neutral-200 mb-2" />
					<input type="file" id="edit-prod-imagen-file" accept="image/png,image/jpeg,image/webp" class="w-full text-xs p-2.5 border border-neutral-200 rounded-sm bg-neutral-50/50 focus:outline-none focus:border-[#FFD1DC] transition-colors cursor-pointer" />
					<p class="text-[10px] text-neutral-400 font-light mt-1">Déjalo vacío para conservar la foto actual. PNG, JPG o WEBP, máx. 5MB.</p>
				</div>
				<button type="submit" class="w-full bg-neutral-800 text-white py-4 text-xs tracking-widest uppercase font-bold hover:bg-[#FFD1DC] hover:text-neutral-800 transition-all duration-300 rounded-sm shadow-md">Guardar Cambios</button>
			</form>
		</div>
	</div>
</Layout>

<script is:inline>
	// La protección de esta zona ocurre en el servidor (src/middleware.ts);
	// si esta página se está renderizando, la sesión de admin ya es válida.
	document.getElementById('btn-logout').addEventListener('click', async () => {
		await fetch('/api/logout', { method: 'POST' });
		window.location.href = '/login';
	});

	// Sincroniza la burbuja del Navbar de forma segura
	let carrito = JSON.parse(localStorage.getItem('carrito') || '[]');
	const countEl = document.getElementById('cart-count');
	if(countEl) {
		const totalItems = carrito.reduce((sum, item) => sum + item.cantidad, 0);
		countEl.innerText = totalItems.toString();
	}

	// 1. SUBIR PRODUCTO NUEVO
	document.getElementById('add-product-form').addEventListener('submit', async (e) => {
		e.preventDefault();
		const nombre = document.getElementById('prod-nombre').value;
		const precio = parseFloat(document.getElementById('prod-precio').value);
		const descripcion = document.getElementById('prod-descripcion').value;
		const archivo = document.getElementById('prod-imagen-file').files[0];

		if (!archivo) {
			alert('⚠️ Selecciona una foto para la prenda.');
			return;
		}

		try {
			const formData = new FormData();
			formData.append('imagen', archivo);

			const respuestaUpload = await fetch('/api/upload', { method: 'POST', body: formData });
			const resultadoUpload = await respuestaUpload.json();

			if (!respuestaUpload.ok || !resultadoUpload.success) {
				alert(`⚠️ Error al subir la imagen: ${resultadoUpload.error}`);
				return;
			}

			const imagen_url = resultadoUpload.imagen_url;

			const respuesta = await fetch('/api/productos', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ nombre, precio, descripcion, imagen_url })
			});
			const resultado = await respuesta.json();
			if (resultado.success) {
				alert(`🎉 ¡Prenda guardada con éxito en tu MySQL!\n\nArtículo: ${nombre}\nRuta asignada: ${imagen_url}`);
				window.location.reload();
			} else {
				alert(`⚠️ Error: ${resultado.error}`);
			}
		} catch (error) {
			alert('❌ Fallo al conectar con MySQL.');
		}
	});

	// 2. RETIRAR / ELIMINAR PRODUCTO DE TIENDA
	document.querySelectorAll('.btn-delete-item').forEach(btn => {
		btn.addEventListener('click', async (e) => {
			const id = e.currentTarget.getAttribute('data-id');
			if (confirm(`🗑️ ¿Estás segura de que deseas retirar la prenda #${id} permanentemente de la tienda?`)) {
				try {
					const respuesta = await fetch('/api/eliminar', {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify({ id })
					});
					const resultado = await respuesta.json();
					if (resultado.success) {
						alert('✅ Artículo eliminado con éxito de tu base de datos MySQL.');
						window.location.reload();
					}
				} catch (error) {
					alert('❌ Error al intentar conectar con la API de borrado.');
				}
			}
		});
	});

	// 3. LOGICA INTERACTIVA DEL MODAL DE EDICIÓN (MISMA PÁGINA)
	const editModal = document.getElementById('edit-modal');
	const closeEditModalBtn = document.getElementById('close-edit-modal');

	document.querySelectorAll('.btn-open-edit').forEach(btn => {
		btn.addEventListener('click', (e) => {
			const data = JSON.parse(e.currentTarget.getAttribute('data-product'));

			document.getElementById('edit-prod-id').value = data.id;
			document.getElementById('edit-prod-nombre').value = data.nombre;
			document.getElementById('edit-prod-precio').value = data.precio;
			document.getElementById('edit-prod-descripcion').value = data.descripcion;
			document.getElementById('edit-prod-imagen-actual').value = data.imagen_url;
			document.getElementById('edit-prod-imagen-preview').src = data.imagen_url;
			document.getElementById('edit-prod-imagen-file').value = '';

			editModal.classList.remove('hidden');
		});
	});

	closeEditModalBtn.addEventListener('click', () => editModal.classList.add('hidden'));
	editModal.addEventListener('click', (e) => { if (e.target === editModal) editModal.classList.add('hidden'); });

	// Previsualizar la nueva foto elegida antes de guardar
	document.getElementById('edit-prod-imagen-file').addEventListener('change', (e) => {
		const archivo = e.currentTarget.files[0];
		if (archivo) {
			document.getElementById('edit-prod-imagen-preview').src = URL.createObjectURL(archivo);
		}
	});

	// 4. GUARDAR CAMBIOS DE EDICIÓN EN MYSQL (texto + imagen opcional)
	document.getElementById('edit-product-form').addEventListener('submit', async (e) => {
		e.preventDefault();
		const id = document.getElementById('edit-prod-id').value;
		const nombre = document.getElementById('edit-prod-nombre').value;
		const precio = parseFloat(document.getElementById('edit-prod-precio').value);
		const descripcion = document.getElementById('edit-prod-descripcion').value;
		const archivo = document.getElementById('edit-prod-imagen-file').files[0];
		let imagen_url = document.getElementById('edit-prod-imagen-actual').value;

		try {
			if (archivo) {
				const formData = new FormData();
				formData.append('imagen', archivo);

				const respuestaUpload = await fetch('/api/upload', { method: 'POST', body: formData });
				const resultadoUpload = await respuestaUpload.json();

				if (!respuestaUpload.ok || !resultadoUpload.success) {
					alert(`⚠️ Error al subir la nueva imagen: ${resultadoUpload.error}`);
					return;
				}
				imagen_url = resultadoUpload.imagen_url;
			}

			const respuesta = await fetch('/api/editar', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ id, nombre, precio, descripcion, imagen_url })
			});
			const resultado = await respuesta.json();
			if (resultado.success) {
				alert(`✨ ¡Prenda #${id} actualizada con éxito en MySQL!`);
				editModal.classList.add('hidden');
				window.location.reload();
			} else {
				alert(`⚠️ Error al actualizar: ${resultado.error}`);
			}
		} catch (error) {
			alert('❌ Error de conexión al procesar la actualización.');
		}
	});

	// 5. TOGGLE "VER ITEMS" DE CADA PEDIDO
	document.querySelectorAll('.btn-toggle-items').forEach(btn => {
		btn.addEventListener('click', (e) => {
			const targetId = e.currentTarget.getAttribute('data-target');
			document.getElementById(targetId)?.classList.toggle('hidden');
		});
	});

	// 6. CAMBIO DE ESTADO DE PEDIDO
	document.querySelectorAll('.pedido-estado-select').forEach(select => {
		const valorPrevio = select.value;
		select.addEventListener('change', async (e) => {
			const id = e.currentTarget.getAttribute('data-id');
			const estado = e.currentTarget.value;
			try {
				const respuesta = await fetch('/api/pedidos/estado', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ id: Number(id), estado })
				});
				const resultado = await respuesta.json();
				if (!respuesta.ok || !resultado.success) {
					alert(resultado.error === 'transicion_invalida'
						? '⚠️ Esa transición de estado no está permitida.'
						: `⚠️ ${resultado.error || 'Error al actualizar el pedido.'}`);
					e.currentTarget.value = valorPrevio;
					return;
				}
				window.location.reload();
			} catch (error) {
				alert('❌ Error de conexión al actualizar el estado.');
				e.currentTarget.value = valorPrevio;
			}
		});
	});
</script>

<style>
	@keyframes fadeIn {
		from { opacity: 0; transform: scale(0.95); }
