---
// src/pages/pedido/[token].astro
import Layout from '../../layouts/Layout.astro';
import pool from '../../lib/db.js';

const { token } = Astro.params;

let pedido = null;
let items = [];

if (token) {
  const [pedidoRows] = await pool.query(
    `SELECT id, token, cliente_nombre, cliente_telefono, direccion_envio,
            metodo_pago, estado, total, fecha
     FROM pedidos WHERE token = ?`,
    [token]
  );
  pedido = pedidoRows[0] || null;

  if (pedido) {
    const [itemRows] = await pool.query(
      `SELECT nombre_producto, precio_unitario, cantidad, subtotal
       FROM pedido_items WHERE pedido_id = ? ORDER BY id`,
      [pedido.id]
    );
    items = itemRows;
  }
}

if (!pedido) {
  Astro.response.status = 404;
}

const ESTADO_LABELS = {
  pendiente_pago: 'Pendiente de pago',
  pagado: 'Pagado',
  enviado: 'Enviado',
  cancelado: 'Cancelado',
};

const METODO_LABELS = {
  transferencia: 'Transferencia bancaria',
  yape: 'Yape',
  plin: 'Plin',
};
---

<Layout title={pedido ? 'Confirmación de Pedido' : 'Pedido no encontrado'}>
	<section class="max-w-2xl mx-auto px-4 py-16 flex-grow">
		{pedido ? (
			<div class="animate-fade-in">
				<div class="text-center mb-10">
					<span class="text-4xl block mb-4">✅</span>
					<h1 class="text-3xl font-bold text-neutral-800 tracking-wide font-['Playfair_Display']">¡Gracias por tu compra!</h1>
					<p class="text-xs text-neutral-400 font-light mt-2 tracking-widest uppercase">Referencia #{pedido.token.slice(0, 8).toUpperCase()}</p>
				</div>

				<div class="bg-white border border-neutral-100 p-6 rounded-sm shadow-xs mb-6">
					<div class="flex justify-between items-center mb-4">
						<h3 class="text-xs uppercase tracking-widest text-neutral-400 font-bold">Estado del pedido</h3>
						<span class="text-[10px] uppercase tracking-widest bg-neutral-900 text-white px-3 py-1.5 font-bold rounded-xs">{ESTADO_LABELS[pedido.estado] || pedido.estado}</span>
					</div>
					<div class="w-full h-[1px] bg-neutral-100 my-4"></div>
					<dl class="space-y-2 text-sm">
						<div class="flex justify-between"><dt class="text-neutral-400">Cliente</dt><dd class="text-neutral-700 font-medium">{pedido.cliente_nombre}</dd></div>
						<div class="flex justify-between"><dt class="text-neutral-400">Teléfono</dt><dd class="text-neutral-700 font-medium">{pedido.cliente_telefono}</dd></div>
						<div class="flex justify-between gap-4"><dt class="text-neutral-400 shrink-0">Dirección</dt><dd class="text-neutral-700 font-medium text-right">{pedido.direccion_envio}</dd></div>
						<div class="flex justify-between"><dt class="text-neutral-400">Método de pago</dt><dd class="text-neutral-700 font-medium">{METODO_LABELS[pedido.metodo_pago] || pedido.metodo_pago}</dd></div>
					</dl>
				</div>

				<div class="bg-white border border-neutral-100 p-6 rounded-sm shadow-xs">
					<h3 class="text-xs uppercase tracking-widest text-neutral-400 font-bold mb-4">Resumen del pedido</h3>
					<div class="divide-y divide-neutral-50">
						{items.map((item) => (
							<div class="flex justify-between py-3 text-sm">
								<div>
									<p class="font-medium text-neutral-800">{item.nombre_producto}</p>
									<p class="text-xs text-neutral-400">{item.cantidad} x ${item.precio_unitario}</p>
								</div>
								<span class="font-medium text-neutral-700">${Number(item.subtotal).toFixed(2)}</span>
							</div>
						))}
					</div>
					<div class="w-full h-[1px] bg-neutral-100 my-4"></div>
					<div class="flex justify-between text-base font-bold text-neutral-800">
						<span>Total</span>
						<span>${Number(pedido.total).toFixed(2)}</span>
					</div>
				</div>

				<div class="text-center mt-8">
					<a href="/catalogo" class="inline-block bg-neutral-800 text-white px-6 py-3 text-[10px] tracking-widest uppercase font-semibold hover:bg-[#FFD1DC] hover:text-neutral-800 transition-all duration-300 rounded-sm shadow-sm">Seguir comprando</a>
				</div>
			</div>
		) : (
			<div class="text-center py-20">
				<span class="text-4xl block mb-4">🔍</span>
				<h1 class="text-2xl font-bold text-neutral-800 mb-2">Pedido no encontrado</h1>
				<p class="text-xs text-neutral-400 font-light mb-6">Verifica el enlace o vuelve al catálogo.</p>
				<a href="/catalogo" class="inline-block bg-neutral-800 text-white px-6 py-3 text-[10px] tracking-widest uppercase font-semibold hover:bg-[#FFD1DC] hover:text-neutral-800 transition-all duration-300 rounded-sm shadow-sm">Ir al catálogo</a>
			</div>
		)}
	</section>
</Layout>

<script is:inline>
	let carrito = JSON.parse(localStorage.getItem('carrito') || '[]');
	const countEl = document.getElementById('cart-count');
	if (countEl) {
		countEl.innerText = carrito.reduce((sum, item) => sum + item.cantidad, 0).toString();
	}
</script>

<style>
	@keyframes fadeIn {
		from { opacity: 0; transform: translateY(10px); }
		to { opacity: 1; transform: translateY(0); }
	}
	.animate-fade-in {
		animation: fadeIn 0.4s ease-out forwards;
	}
</style>
